{
	"name": "PL_Demo_Complete",
	"properties": {
		"activities": [
			{
				"name": "Cx table ingest from AS to ADLS",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Read cx table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Azure_SQL",
						"type": "DatasetReference",
						"parameters": {
							"schemaName": "dbo",
							"tableName": {
								"value": "@pipeline().parameters.table_name_pipeline",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Customer",
						"type": "DatasetReference",
						"parameters": {
							"table_name": {
								"value": "@pipeline().parameters.table_name_pipeline",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Read cx table",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select * from dbo.customers where CustomerID >2",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_Azure_SQL",
						"type": "DatasetReference",
						"parameters": {
							"schemaName": "dbo",
							"tableName": "Customers"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Success_Email_Pipeline_Trigger",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Cx table ingest from AS to ADLS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_EmailDemo",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"tableName": {
							"value": "@pipeline().parameters.table_name_pipeline",
							"type": "Expression"
						},
						"email_receipt": {
							"value": "@pipeline().globalParameters.email_recepient_global",
							"type": "Expression"
						},
						"status": "Success"
					}
				}
			},
			{
				"name": "Failure_Email_Pipeline_Trigger",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Cx table ingest from AS to ADLS",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_EmailDemo",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"tableName": {
							"value": "@pipeline().parameters.table_name_pipeline",
							"type": "Expression"
						},
						"email_receipt": {
							"value": "@pipeline().globalParameters.email_recepient_global",
							"type": "Expression"
						},
						"status": "Failed"
					}
				}
			}
		],
		"parameters": {
			"table_name_pipeline": {
				"type": "string",
				"defaultValue": "customers"
			},
			"email_receipt_pipeline": {
				"type": "string",
				"defaultValue": "vaibhavgupta1176@gmail.com"
			}
		},
		"annotations": []
	}
}