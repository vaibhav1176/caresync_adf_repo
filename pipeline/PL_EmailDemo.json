{
	"name": "PL_EmailDemo",
	"properties": {
		"activities": [
			{
				"name": "SendEmail",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare Logic App Email",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-08.centralindia.logic.azure.com:443/workflows/1c4a4dc698e747a98d10bbd418b04c5a/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=2vtaCiIX64ZtOxDT2Pj7MVKuEvOyp0sDTYNouHO6VEY",
					"body": {
						"value": "{\"tableName\": \"@{pipeline().parameters.tableName}\"}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Logic App Email",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare Email Body",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"email_recepient\":\"@{pipeline().parameters.email_receipt}\",\n\"email_subject\":\"@{variables('email_subject')}\",\n\"email_body\":\"@{variables('email_body')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email Subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().parameters.tableName} - @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email Body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "The table @{pipeline().parameters.tableName} have been ingested and the status is @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"tableName": {
				"type": "string"
			},
			"email_receipt": {
				"type": "string"
			},
			"status": {
				"type": "string"
			}
		},
		"variables": {
			"logic_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-08T02:45:27Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}